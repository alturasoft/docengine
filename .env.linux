# ===========================================================================
# DocEngine — Perfil de Configuración: LINUX (Alto Rendimiento / Máxima Calidad)
# ===========================================================================
# Este archivo es cargado automáticamente al detectar el sistema operativo Linux.
# Sobreescribe los valores del archivo base .env.

# --- Pipeline y Concurrencia Docling ---
# En Linux aprovecha 8 hilos de procesamiento paralelo de páginas
DOCENGINE_PIPELINE_NUM_THREADS=8
DOCENGINE_PIPELINE_ACCELERATOR_DEVICE=cpu
DOCENGINE_PIPELINE_PDF_BACKEND=docling_parse_v2

# Escala nativa estándar 1.0 (72 DPI): conserva 100% la calidad del texto y estructura,
# eliminando el sobrecosto de resolución 2x (4x píxeles) en inferencia de visión.
DOCENGINE_PIPELINE_IMAGES_SCALE=1.0

# --- Extracción y Estructura de Tablas ---
# ACCURATE garantiza fidelidad total en tablas complejas de pólizas de seguros
DOCENGINE_EXTRACTION_TABLE_MODE=ACCURATE
DOCENGINE_EXTRACTION_DO_TABLE_STRUCTURE=true
DOCENGINE_EXTRACTION_DO_CELL_MATCHING=true
DOCENGINE_EXTRACTION_AUTO_DETECT_PDF_TYPE=true

# --- Rendimiento de Procesamiento por Lotes ---
DOCENGINE_PERF_BATCH_SIZE=8
DOCENGINE_PERF_MAX_UPLOAD_SIZE_MB=500
DOCENGINE_PERF_REQUEST_TIMEOUT_SECONDS=300
DOCENGINE_PERF_MEMORY_WARNING_THRESHOLD_MB=8192

# --- Embeddings Locales (bge-m3) ---
# Batch size de 64 acelera la vectorización matricial sin alterar los vectores resultantes
DOCENGINE_EMBED_BATCH_SIZE=64
DOCENGINE_EMBED_DEVICE=cpu
DOCENGINE_EMBED_CHUNK_SIZE_CHARS=2500
DOCENGINE_EMBED_CHUNK_OVERLAP_CHARS=200

# --- RAG y Reranker ---
DOCENGINE_RERANKER_ENABLED=true
DOCENGINE_RERANKER_TOP_N=3
DOCENGINE_RERANKER_DEVICE=cpu

# --- Optimizaciones PyTorch ---
TORCHDYNAMO_DISABLE=1
TORCH_COMPILE_DISABLE=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
