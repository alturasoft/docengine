# ===========================================================================
# DocEngine — Perfil de Configuración: WINDOWS (Desarrollo Ligero / Bajo Consumo)
# ===========================================================================
# Este archivo es cargado automáticamente al detectar el sistema operativo Windows.
# Sobreescribe los valores del archivo base .env.

# --- Pipeline y Concurrencia Docling ---
# En Windows desarrollo, hilos moderados para evitar saturación de CPU y UI lag
DOCENGINE_PIPELINE_NUM_THREADS=4
DOCENGINE_PIPELINE_ACCELERATOR_DEVICE=cpu
DOCENGINE_PIPELINE_PDF_BACKEND=pypdfium2
DOCENGINE_PIPELINE_IMAGES_SCALE=1.5

# --- Extracción y Estructura de Tablas ---
DOCENGINE_EXTRACTION_TABLE_MODE=ACCURATE
DOCENGINE_EXTRACTION_DO_TABLE_STRUCTURE=true
DOCENGINE_EXTRACTION_DO_CELL_MATCHING=true
DOCENGINE_EXTRACTION_AUTO_DETECT_PDF_TYPE=true

# --- Rendimiento de Procesamiento por Lotes ---
DOCENGINE_PERF_BATCH_SIZE=2
DOCENGINE_PERF_MAX_UPLOAD_SIZE_MB=200
DOCENGINE_PERF_REQUEST_TIMEOUT_SECONDS=300
DOCENGINE_PERF_MEMORY_WARNING_THRESHOLD_MB=4096

# --- Embeddings Locales (bge-m3) ---
DOCENGINE_EMBED_BATCH_SIZE=16
DOCENGINE_EMBED_DEVICE=cpu
DOCENGINE_EMBED_CHUNK_SIZE_CHARS=1800
DOCENGINE_EMBED_CHUNK_OVERLAP_CHARS=150

# --- RAG y Reranker ---
# En Windows de desarrollo se puede deshabilitar el reranker para menor consumo de RAM (mock rápido)
DOCENGINE_RERANKER_ENABLED=false
DOCENGINE_RERANKER_TOP_N=3
DOCENGINE_RERANKER_DEVICE=cpu

# --- Optimizaciones PyTorch ---
TORCHDYNAMO_DISABLE=1
TORCH_COMPILE_DISABLE=1
