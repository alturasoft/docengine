# DocEngine — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DOCENGINE_ENV=development
DOCENGINE_APP_NAME=DocEngine
DOCENGINE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Extraction Pipeline
# ---------------------------------------------------------------------------
# OCR: keep False for PDFs with embedded text (Phase 1).
# Activar en Phase 2 solo para PDFs escaneados / imagen pura.
DOCENGINE_EXTRACTION_DO_OCR=false
DOCENGINE_EXTRACTION_TABLE_MODE=ACCURATE
DOCENGINE_EXTRACTION_DO_TABLE_STRUCTURE=true
DOCENGINE_EXTRACTION_DO_CELL_MATCHING=true
DOCENGINE_EXTRACTION_GENERATE_PICTURE_IMAGES=false

# Post-processing: collapse letter-spaced text ("E n V i r t u d" -> "En Virtud")
# Produced by non-standard embedded font glyph maps in some insurance PDFs.
DOCENGINE_EXTRACTION_FIX_SPACED_TEXT=true
DOCENGINE_EXTRACTION_SPACED_TEXT_MIN_RATIO=0.4

# Post-processing: detect and split Markdown tables incorrectly merged by TableFormer
# due to visual proximity in the PDF layout.
DOCENGINE_EXTRACTION_SPLIT_MERGED_TABLES=true

# ---------------------------------------------------------------------------
# PDF Type Auto-Detection (Phase 2: Dynamic OCR)
# ---------------------------------------------------------------------------
# When enabled, DocEngine pre-classifies each PDF BEFORE running Docling:
#   digital  → texto embebido nativo (no OCR needed)
#   scanned  → imagen escaneada (OCR activado con force_full_page_ocr=True)
#   hybrid   → mezcla de páginas digitales y escaneadas (OCR sin force_full_page)
#   unknown  → no determinado (URL sources, error de lectura) → sin OCR
#
# La detección usa pypdfium2.count_chars() por página — sub-segundo, sin modelos ML.
# Motor OCR activado automáticamente: EasyOCR [es, en].
DOCENGINE_EXTRACTION_AUTO_DETECT_PDF_TYPE=true

# Umbral de páginas escaneadas para clasificar como SCANNED (vs HYBRID).
# Ejemplo: 0.5 = más del 50% de páginas escaneadas → SCANNED + force_full_page_ocr
DOCENGINE_EXTRACTION_SCANNED_PAGE_RATIO_THRESHOLD=0.5

# Mínimo de caracteres por página para considerarla como texto embebido (no escaneada).
# Páginas con menos caracteres que este valor se tratan como escaneadas.
DOCENGINE_EXTRACTION_MIN_CHARS_PER_PAGE=15

# Máximo de páginas a inspeccionar durante la pre-clasificación.
# Para PDFs grandes, se toma una muestra del inicio, medio y fin.
DOCENGINE_EXTRACTION_MAX_SAMPLE_PAGES=10

# Page range (optional — leave empty for full document)
# DOCENGINE_EXTRACTION_PAGE_RANGE_START=1
# DOCENGINE_EXTRACTION_PAGE_RANGE_END=50


# ---------------------------------------------------------------------------
# Docling Pipeline
# ---------------------------------------------------------------------------
DOCENGINE_PIPELINE_NUM_THREADS=4
DOCENGINE_PIPELINE_ACCELERATOR_DEVICE=cpu

# PDF parsing backend:
#   'docling_parse_v2' (default) — best handling of non-standard embedded fonts
#     common in Latin-American insurance PDFs. Suitable for docs up to 500 pages.
#   'pypdfium2' — lower memory footprint; use for very large or corrupt PDFs.
#   'docling_parse'  — legacy v1; kept for compatibility only.
DOCENGINE_PIPELINE_PDF_BACKEND=docling_parse_v2

# Internal page render scale for layout/region analysis (1.0–4.0).
# 2.0 improves boundary detection in dense multi-column and table layouts.
DOCENGINE_PIPELINE_IMAGES_SCALE=2.0

# Air-gapped environments: path to pre-downloaded Docling model artifacts
# DOCENGINE_PIPELINE_ARTIFACTS_PATH=/path/to/docling_models

# PyTorch / TorchInductor & HuggingFace settings
# TORCH_COMPILE_DISABLE=1 (prevents C++ JIT compilation overhead in Docker/CPU)
TORCH_COMPILE_DISABLE=1
# HF_TOKEN=your_huggingface_hub_token (optional: avoids unauthenticated rate limits)

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
DOCENGINE_OUTPUT_OUTPUT_DIR=./outputs
DOCENGINE_OUTPUT_INCLUDE_METADATA=true
DOCENGINE_OUTPUT_INCLUDE_REPORT=true
DOCENGINE_OUTPUT_MARKDOWN_PREVIEW_CHARS=500

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DOCENGINE_LOG_LEVEL=INFO
# Use 'json' for production, 'console' for development
DOCENGINE_LOG_FORMAT=console
# DOCENGINE_LOG_LOG_FILE=./logs/docengine.log

# ---------------------------------------------------------------------------
# OCR (Phase 2 — leave as-is for Phase 1)
# ---------------------------------------------------------------------------
DOCENGINE_OCR_ENGINE=easyocr
DOCENGINE_OCR_LANGUAGES=["es","en"]
DOCENGINE_OCR_FORCE_FULL_PAGE_OCR=false

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
DOCENGINE_PERF_BATCH_SIZE=4
DOCENGINE_PERF_MAX_UPLOAD_SIZE_MB=200
DOCENGINE_PERF_REQUEST_TIMEOUT_SECONDS=300
DOCENGINE_PERF_MEMORY_WARNING_THRESHOLD_MB=2048

# ---------------------------------------------------------------------------
# Markdown Post-Processing
# ---------------------------------------------------------------------------
DOCENGINE_MD_REMOVE_REPEATED_HEADERS=true
DOCENGINE_MD_REMOVE_REPEATED_FOOTERS=true
DOCENGINE_MD_REPETITION_THRESHOLD=0.7
DOCENGINE_MD_NORMALIZE_WHITESPACE=true
DOCENGINE_MD_MAX_CONSECUTIVE_BLANK_LINES=2

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# Use 'postgres_db' when running inside Docker Compose, or 'localhost' for local non-docker.
# ---------------------------------------------------------------------------
DOCENGINE_DB_HOST=postgres_db
DOCENGINE_DB_PORT=5432
DOCENGINE_DB_NAME=docengine
DOCENGINE_DB_USER=postgres
DOCENGINE_DB_PASSWORD=postgres
DOCENGINE_DB_POOL_MIN=2
DOCENGINE_DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Embeddings (BAAI/bge-m3 — local)
# ---------------------------------------------------------------------------
DOCENGINE_EMBED_MODEL_NAME=BAAI/bge-m3
DOCENGINE_EMBED_BATCH_SIZE=32
DOCENGINE_EMBED_DEVICE=cpu
DOCENGINE_EMBED_CHUNK_SIZE_CHARS=1800
DOCENGINE_EMBED_CHUNK_OVERLAP_CHARS=200

# ---------------------------------------------------------------------------
# OpenAI (solo para extracción estructurada JSON con gpt-4o)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-api-key-here

# ---------------------------------------------------------------------------
# RAG Query Service (read path — responde preguntas con contexto de documentos)
# ---------------------------------------------------------------------------
# Número de chunks a recuperar por consulta (1–20). Default: 5.
DOCENGINE_RAG_TOP_K=5

# Umbral mínimo de similitud coseno para incluir un chunk en el contexto (0.0–1.0).
# 0.3 = descarta chunks poco relevantes | 0.5+ = solo coincidencias cercanas.
DOCENGINE_RAG_SIMILARITY_THRESHOLD=0.3

# Modelo OpenAI para generación de respuestas.
# 'gpt-4o-mini' (rápido, económico) | 'gpt-4o' (mayor calidad, más costoso).
DOCENGINE_RAG_LLM_MODEL=gpt-4o-mini

# Máximo de tokens en la respuesta generada por el LLM. Default: 2048.
DOCENGINE_RAG_MAX_TOKENS=2048

# Temperatura del LLM. Fija en 0.0 para máxima fidelidad factual.
# NO modificar salvo requerimiento explícito.
DOCENGINE_RAG_TEMPERATURE=0.0
